---
import "@/styles/globals.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogImageUrl = new URL("/og-image.jpg", Astro.site ?? Astro.url).href;
const ogImageAlt =
  "Lienzo de pergamino con el título Conway’s Game of Life, una esfera iridiscente y un planeador de células de tinta.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Conway’s Game of Life",
  alternateName: "Game of Life",
  description,
  url: canonicalUrl,
  applicationCategory: "GameApplication",
  operatingSystem: "Any",
  inLanguage: "es",
  image: ogImageUrl,
  author: {
    "@type": "Person",
    name: "bue221",
    url: "https://github.com/bue221",
  },
  codeRepository: "https://github.com/bue221/astro-coway-game",
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Conway, Game of Life, autómata celular, glider, simulador, cellular automaton"
    />
    <meta name="author" content="bue221" />
    <meta name="theme-color" content="#e5e4e0" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Conway’s Game of Life" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  </head>
  <body class="relative overflow-x-hidden">
    <div
      class="hero-sphere pointer-events-none absolute right-[-12%] top-[-10%] z-0 size-[min(38vw,240px)] md:right-[-4%] md:top-[-8%] md:size-[min(32vh,380px)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="ornament-ring pointer-events-none absolute left-[-28%] top-[14%] z-0 size-[min(90vw,720px)] opacity-80 md:left-[-12%] md:top-[18%]"
      aria-hidden="true"
    >
    </div>
    <div
      class="ornament-ring pointer-events-none absolute left-[-18%] top-[22%] z-0 size-[min(70vw,560px)] opacity-60 md:left-[-6%] md:top-[24%]"
      aria-hidden="true"
    >
    </div>

    <header class="relative z-10 mx-auto max-w-page">
      <nav
        class="flex items-center justify-between border-b border-ash px-[15px] py-[19px] md:px-[30px]"
      >
        <p
          class="text-caption uppercase text-ink"
          style="letter-spacing: 0.05em"
        >
          Game of Life
        </p>
        <a
          class="rounded-links px-0 py-[5px] text-body-sm text-ink hover:underline"
          href="https://github.com/bue221/astro-coway-game/tree/main"
          target="_blank"
          rel="noreferrer"
        >
          Source →
        </a>
      </nav>
    </header>

    <div class="relative z-10 mx-auto max-w-page px-[15px] pt-[19px] md:px-[30px] md:pt-[32px]">
      <p class="text-caption uppercase text-ink" style="letter-spacing: 0.05em">
        Cellular automaton
      </p>
      <h1
        class="mt-[15px] max-w-[11ch] uppercase text-ink"
        style="font-size: clamp(46px, 8vw, 76px); line-height: var(--leading-heading-lg); letter-spacing: var(--tracking-heading-lg); font-weight: var(--font-weight-regular)"
      >
        Conway’s<br />Game of Life
      </h1>
    </div>

    <slot />

    <footer
      class="relative z-10 mx-auto max-w-page border-t border-ash px-[15px] py-[32px] md:px-[30px] md:py-[46px]"
    >
      <p
        class="whitespace-nowrap text-left text-caption uppercase text-ink"
        style="letter-spacing: 0.05em"
      >
        Made by @bue221
      </p>
    </footer>
  </body>
</html>
